    <mxCell id="A1" value="&lt;b&gt;WaveFake&lt;/b&gt; (English) &amp;#8212; source domain&lt;br&gt;7 GAN / flow vocoders &amp;#183; 117,985 utterances &amp;#183; 22.05 kHz" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontFamily=Helvetica;fontSize=17;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="500" height="86" as="geometry"/></mxCell>
    <mxCell id="A2" value="&lt;b&gt;BanglaFake&lt;/b&gt; (Bengali) &amp;#8212; target domain&lt;br&gt;1 VITS end-to-end TTS &amp;#183; 25,520 utterances &amp;#183; 22.05 kHz" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontFamily=Helvetica;fontSize=17;" vertex="1" parent="1"><mxGeometry x="560" y="20" width="500" height="86" as="geometry"/></mxCell>

    <mxCell id="B1" value="&lt;b&gt;High-Band-Preserving preprocessing&lt;/b&gt;&amp;#160;&amp;#160;&amp;#8212;&amp;#160;&amp;#160;native 22.05 kHz retained &amp;#183; mono &amp;#183; silence trim &amp;#183; 4 s&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot; color=&quot;#8a6d00&quot;&gt;&lt;i&gt;keeps the 8&amp;#8211;11 kHz band where synthesis artifacts concentrate&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontFamily=Helvetica;fontSize=17;" vertex="1" parent="1"><mxGeometry x="20" y="138" width="1040" height="78" as="geometry"/></mxCell>

    <mxCell id="C1" value="&lt;b&gt;Branch-S&lt;/b&gt;&amp;#160;&amp;#8212;&amp;#160;sparse cepstral&lt;br&gt;&lt;br&gt;STFT (2048 / 512)&amp;#160;&amp;#8594;&amp;#160;linear FB (20)&lt;br&gt;&amp;#8594;&amp;#160;DCT&amp;#160;&amp;#8594;&amp;#160;20 coefficients&amp;#160;&amp;#8594;&amp;#160;&amp;#916; + &amp;#916;&amp;#916;&lt;br&gt;&amp;#8658;&amp;#160;(60, T)&amp;#160;&amp;#8594;&amp;#160;299&amp;#215;299&amp;#215;3&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;adapter stem A&lt;sub&gt;S&lt;/sub&gt;&amp;#160;&amp;#183;&amp;#160;2&amp;#215; conv 3&amp;#215;3&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontFamily=Helvetica;fontSize=17;" vertex="1" parent="1"><mxGeometry x="20" y="248" width="500" height="180" as="geometry"/></mxCell>
    <mxCell id="C2" value="&lt;b&gt;Branch-D&lt;/b&gt;&amp;#160;&amp;#8212;&amp;#160;dense spectral&lt;br&gt;&lt;br&gt;STFT (2048 / 512)&amp;#160;&amp;#8594;&amp;#160;mel FB (128)&lt;br&gt;&amp;#8594;&amp;#160;log-power, &lt;i&gt;no&lt;/i&gt; DCT&amp;#160;&amp;#8594;&amp;#160;&amp;#916; + &amp;#916;&amp;#916;&lt;br&gt;&amp;#8658;&amp;#160;(3, 128, T)&amp;#160;&amp;#8594;&amp;#160;299&amp;#215;299&amp;#215;3&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;adapter stem A&lt;sub&gt;D&lt;/sub&gt;&amp;#160;&amp;#183;&amp;#160;2&amp;#215; conv 3&amp;#215;3&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontFamily=Helvetica;fontSize=17;" vertex="1" parent="1"><mxGeometry x="560" y="248" width="500" height="180" as="geometry"/></mxCell>

    <mxCell id="D1" value="&lt;b&gt;Shared Xception trunk&amp;#160;&amp;#934;&lt;/b&gt;&amp;#160;&amp;#160;&amp;#8212;&amp;#160;&amp;#160;ImageNet-pretrained, ~23 M, &lt;i&gt;tied weights&lt;/i&gt;&lt;br&gt;F&lt;sub&gt;S&lt;/sub&gt; = &amp;#934;(A&lt;sub&gt;S&lt;/sub&gt;(x&lt;sub&gt;S&lt;/sub&gt;)),&amp;#160;&amp;#160;F&lt;sub&gt;D&lt;/sub&gt; = &amp;#934;(A&lt;sub&gt;D&lt;/sub&gt;(x&lt;sub&gt;D&lt;/sub&gt;))&amp;#160;&amp;#160;&amp;#8712;&amp;#160;&amp;#8477;&lt;sup&gt;10&amp;#215;10&amp;#215;2048&lt;/sup&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontFamily=Helvetica;fontSize=17;" vertex="1" parent="1"><mxGeometry x="20" y="458" width="1040" height="88" as="geometry"/></mxCell>

    <mxCell id="E1" value="&lt;b&gt;Cross-Attention Spectral Fusion (CASF)&lt;/b&gt;&lt;br&gt;token projection 2048&amp;#160;&amp;#8594;&amp;#160;256&amp;#160;&amp;#183;&amp;#160;two-way multi-head cross-attention (h = 4)&amp;#160;&amp;#183;&amp;#160;residual + LayerNorm&lt;br&gt;gated fusion&amp;#160;&amp;#160;z = g &amp;#8857; h&amp;#770;&lt;sub&gt;D&lt;/sub&gt; + (1 &amp;#8722; g) &amp;#8857; h&amp;#770;&lt;sub&gt;S&lt;/sub&gt;&amp;#160;&amp;#160;&amp;#8658;&amp;#160;&amp;#160;z &amp;#8712; &amp;#8477;&lt;sup&gt;256&lt;/sup&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontFamily=Helvetica;fontSize=17;" vertex="1" parent="1"><mxGeometry x="20" y="576" width="1040" height="116" as="geometry"/></mxCell>

